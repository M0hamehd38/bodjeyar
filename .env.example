# ─────────────────────────────────────────────────────────────────────────────
# هوش مصنوعی بودجه‌یار — همان متغیرهای «هوش سازمانی» و «ارزشیابی».
# این فایل را به ‎.env.local کپی کنید. هر چیزی خالی بماند، بخش‌های هوشمند پنهان
# می‌مانند و بقیه‌ی برنامه کامل کار می‌کند. کلیدها فقط روی سرورند.
# ─────────────────────────────────────────────────────────────────────────────

# arvan | openai | anthropic  (خالی ⇒ هر کدام که کلیدش هست، اول آروان)
AI_PROVIDER=arvan
# AI_ENABLED=0  ← همه‌ی قابلیت‌های هوشمند را خاموش می‌کند

# درگاه هوش مصنوعی آروان (کلید را همان‌طور که پنل می‌دهد بگذارید: «apikey …»)
ARVAN_AI_BASE_URL=https://api.arvancloudai.ir/v1
ARVAN_AI_API_KEY=
ARVAN_CHAT_MODEL=DeepSeek-V4-Flash

# دو مدل — مدیر در تنظیمات › هوش مصنوعی برای هر کار یکی را انتخاب می‌کند
# «مدل دقیق» — همان مدل «گام»
ARVAN_PRECISE_MODEL=GPT-5.6-Luna
# «مدل روزمره» — همان مدل «ارزشیابی»
ARVAN_EVERYDAY_MODEL=DeepSeek-V4-Flash

# کلید و Endpoint جدای هر مدل (اختیاری؛ خالی ⇒ همان ARVAN_AI_* بالا)
# مدل دقیق با کلید «گام» و مدل روزمره با کلید «ارزشیابی»، مثل هوش سازمانی
ARVAN_PRECISE_AI_BASE_URL=
ARVAN_PRECISE_AI_API_KEY=
ARVAN_EVERYDAY_AI_BASE_URL=
ARVAN_EVERYDAY_AI_API_KEY=

# جایگزین‌ها
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_PRECISE_MODEL=
# OPENAI_EVERYDAY_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_PRECISE_MODEL=claude-opus-5-5
# ANTHROPIC_EVERYDAY_MODEL=claude-sonnet-5-5

# AI_REQUEST_TIMEOUT_MS=180000
# AI_MAX_RETRIES=2
